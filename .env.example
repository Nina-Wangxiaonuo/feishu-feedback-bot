# 飞书自建应用（用于读取多维表格）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# 已有收集表
FEISHU_APP_TOKEN=UVjDbQbaRas8LUsp9FocdTn2nBe
FEISHU_TABLE_ID=tblqJKetf1zkkSKU

# 应用机器人已加入目标群时，填写群 chat_id（oc_ 开头）
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 可选备用：目标群的自定义机器人 Webhook；有 CHAT_ID 时无需填写
FEISHU_WEBHOOK_URL=
# 如果机器人开启了“签名校验”，填写；未开启则留空
FEISHU_WEBHOOK_SECRET=

# 与截图字段一致，可按实际名称调整
FIELD_USER=反馈人员
FIELD_FEEDBACK=功能描述
FIELD_TIME=反馈时间
FIELD_OS=操作系统
FIELD_STATUS=处理状态
UNPROCESSED_VALUE=未处理

TIMEZONE=Asia/Shanghai
# -1 表示每天生成昨天的日报；0 表示当天
DATE_OFFSET_DAYS=-1
TOP_N=8
# true 时不发群，只在终端输出卡片 JSON
DRY_RUN=false

# AI 智能分析（密钥只填写在 .env，不要提交 Git）
AI_ENABLED=false
AI_BASE_URL=https://mp.z01.normandyfunc.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-sol
AI_TIMEOUT=90
AI_ANALYSIS_VERSION=v1

# 首次运行可留空，机器人有 bitable:app 权限时会在同一 Base 自动创建并定位
FEISHU_DAILY_TABLE_ID=
FEISHU_ISSUE_TABLE_ID=
